# Copy to grant_advisor/.env for local runs (adk web). Cloud Run gets these from deploy.sh.
GOOGLE_CLOUD_PROJECT=your-project-id
# Gemini via Vertex AI. "global" works for current Gemini models.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-flash-latest
# Where your tables live: US, or us-central1 if you moved them for the reservation.
BQ_LOCATION=US
BQ_DATASET=a4i_econ
BQ_GRAPH=a4i_econ.LocalEconomy
